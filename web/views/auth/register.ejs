<%- include('../partials/header') %>
<div class="card" style="max-width: 480px; margin: 2rem auto; padding: 2.5rem;">
  <h2 style="text-align: center; margin-bottom: 1.5rem;">Đăng Ký Khách Hàng</h2>

  <% if (error) { %>
    <div class="alert alert-danger"><%= error %></div>
  <% } %>

  <form action="/register" method="POST">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="full_name">Họ và Tên</label>
      <input type="text" id="full_name" name="full_name" class="form-control" placeholder="Nguyễn Văn A" required>
    </div>
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="email">Địa Chỉ Email</label>
      <input type="email" id="email" name="email" class="form-control" placeholder="khachhang@gmail.com" required>
    </div>
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="phone">Số Điện Thoại</label>
      <input type="text" id="phone" name="phone" class="form-control" placeholder="0912345678">
    </div>
    <div class="form-group" style="margin-bottom: 1rem;">
      <label for="username">Tên Đăng Nhập</label>
      <input type="text" id="username" name="username" class="form-control" placeholder="Chữ cái và số" required>
    </div>
    <div class="form-group" style="margin-bottom: 1.5rem;">
      <label for="password">Mật Khẩu</label>
      <input type="password" id="password" name="password" class="form-control" placeholder="Ít nhất 6 ký tự" required>
    </div>
    <button type="submit" class="btn btn-primary" style="width: 100%;">Tạo Tài Khoản</button>
  </form>

  <div style="text-align: center; margin-top: 1.5rem; font-size: 0.9rem; color: var(--text-muted);">
    Đã có tài khoản? <a href="/login">Đăng nhập ngay</a>
  </div>
</div>
<%- include('../partials/footer') %>
