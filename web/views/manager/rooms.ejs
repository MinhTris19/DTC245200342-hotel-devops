<%- include('../partials/header') %>
<h2 style="margin-bottom: 1.5rem; font-weight: 800;">Quản Lý Danh Sách Phòng</h2>

<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
  <div class="card" style="padding: 0; overflow: hidden;">
    <table class="table">
      <thead>
        <tr>
          <th>Số Phòng</th>
          <th>Tầng</th>
          <th>Loại Phòng</th>
          <th>Trạng Thái</th>
          <th>Hành Động</th>
        </tr>
      </thead>
      <tbody>
        <% rooms.forEach(r => { %>
          <tr>
            <td><strong>Phòng <%= r.room_number %></strong></td>
            <td>Tầng <%= r.floor %></td>
            <td><%= r.room_type_name %></td>
            <td><span class="badge badge-<%= r.status %>"><%= r.status %></span></td>
            <td>
              <form action="/manager/rooms/<%= r.id %>/toggle-maintenance" method="POST">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-outline btn-sm">
                  <%= r.status === 'maintenance' ? 'Mở Lại' : 'Bảo Trì' %>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h3 style="margin-bottom: 1rem;">Thêm Phòng Mới</h3>
    <form action="/manager/rooms" method="POST">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group" style="margin-bottom: 1rem;">
        <label>Số Phòng</label>
        <input type="text" name="room_number" class="form-control" required placeholder="501">
      </div>
      <div class="form-group" style="margin-bottom: 1rem;">
        <label>Tầng</label>
        <input type="number" name="floor" class="form-control" min="1" max="20" required value="5">
      </div>
      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label>Loại Phòng</label>
        <select name="room_type_id" class="form-control" required>
          <% roomTypes.forEach(rt => { %>
            <option value="<%= rt.id %>"><%= rt.name %> (<%= Number(rt.base_price).toLocaleString('vi-VN') %> đ)</option>
          <% }) %>
        </select>
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">Thêm Phòng</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
