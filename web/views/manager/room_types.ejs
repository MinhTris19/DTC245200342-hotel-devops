<%- include('../partials/header') %>
<h2 style="margin-bottom: 1.5rem; font-weight: 800;">Quản Lý Hạng Phòng</h2>

<% if (success) { %><div class="alert alert-success"><%= success %></div><% } %>
<% if (error) { %><div class="alert alert-danger"><%= error %></div><% } %>

<div style="display: grid; grid-template-columns: 2fr 1fr; gap: 2rem;">
  <div class="card" style="padding: 0; overflow: hidden;">
    <table class="table">
      <thead>
        <tr>
          <th>Hình Ảnh</th>
          <th>Tên Hạng Phòng</th>
          <th>Giá / Đêm</th>
          <th>Sức Chứa</th>
          <th>Trạng Thái</th>
        </tr>
      </thead>
      <tbody>
        <% roomTypes.forEach(rt => { %>
          <tr>
            <td><img src="<%= rt.image_path %>" width="60" height="40" style="object-fit: cover; border-radius: 4px;"></td>
            <td><strong><%= rt.name %></strong></td>
            <td><%= Number(rt.base_price).toLocaleString('vi-VN') %> đ</td>
            <td><%= rt.capacity %> người</td>
            <td><span class="badge badge-<%= rt.is_active ? 'available' : 'cancelled' %>"><%= rt.is_active ? 'Active' : 'Locked' %></span></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div class="card">
    <h3 style="margin-bottom: 1rem;">Thêm Hạng Phòng Mới</h3>
    <form action="/manager/room-types?_csrf=<%= csrfToken %>" method="POST" enctype="multipart/form-data">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group" style="margin-bottom: 1rem;">
        <label>Tên Hạng Phòng</label>
        <input type="text" name="name" class="form-control" required placeholder="Executive Suite">
      </div>
      <div class="form-group" style="margin-bottom: 1rem;">
        <label>Mô Tả</label>
        <textarea name="description" class="form-control" rows="2" required></textarea>
      </div>
      <div class="form-group" style="margin-bottom: 1rem;">
        <label>Giá Niêm Yết (VND / đêm)</label>
        <input type="number" name="base_price" class="form-control" min="0" required placeholder="1500000">
      </div>
      <div class="form-group" style="margin-bottom: 1rem;">
        <label>Sức Chứa Tối Đa (Người)</label>
        <input type="number" name="capacity" class="form-control" min="1" max="10" required value="2">
      </div>
      <div class="form-group" style="margin-bottom: 1rem;">
        <label>Tiện Nghi (cách nhau dấu phẩy)</label>
        <input type="text" name="amenities" class="form-control" placeholder="WiFi, Bồn tắm, Ban công">
      </div>
      <div class="form-group" style="margin-bottom: 1.5rem;">
        <label>Tải Lên Ảnh Đại Diện (PNG, JPG, WEBP <= 2MB)</label>
        <input type="file" name="image" class="form-control" accept="image/png,image/jpeg,image/webp">
      </div>
      <button type="submit" class="btn btn-primary" style="width: 100%;">Tạo Hạng Phòng</button>
    </form>
  </div>
</div>
<%- include('../partials/footer') %>
