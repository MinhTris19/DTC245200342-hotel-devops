{
  "title": "Hotel - PostgreSQL",
  "uid": "hotel-postgres",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "title": "Active Backends (Database Connections)",
      "type": "stat",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "pg_stat_database_numbackends{datname=\"hotel\"}",
          "legendFormat": "Connections"
        }
      ]
    },
    {
      "id": 2,
      "title": "Transactions per Second (Commit vs Rollback)",
      "type": "timeseries",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit{datname=\"hotel\"}[1m])",
          "legendFormat": "Commits/s"
        },
        {
          "expr": "rate(pg_stat_database_xact_rollback{datname=\"hotel\"}[1m])",
          "legendFormat": "Rollbacks/s"
        }
      ]
    },
    {
      "id": 3,
      "title": "Database Cache Hit Ratio",
      "type": "gauge",
      "gridPos": {
        "h": 6,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "targets": [
        {
          "expr": "pg_stat_database_blks_hit{datname=\"hotel\"} / (pg_stat_database_blks_hit{datname=\"hotel\"} + pg_stat_database_blks_read{datname=\"hotel\"}) * 100",
          "legendFormat": "Cache Hit %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": 0
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "green",
                "value": 90
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Tuples Returned / Fetched Rate",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_tup_returned{datname=\"hotel\"}[1m])",
          "legendFormat": "Returned"
        },
        {
          "expr": "rate(pg_stat_database_tup_fetched{datname=\"hotel\"}[1m])",
          "legendFormat": "Fetched"
        }
      ]
    },
    {
      "id": 5,
      "title": "Database Disk Size",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes{datname=\"hotel\"}",
          "legendFormat": "hotel DB Size"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      }
    }
  ]
}